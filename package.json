{
  "name": "snipforge",
  "version": "0.2.0",
  "description": "SnipForge — 集截图、录屏、剪贴板、图床、图片处理于一体的 Windows 桌面工具",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adream2/SnipForge.git"
  },
  "homepage": "https://github.com/adream2/SnipForge",
  "bugs": {
    "url": "https://github.com/adream2/SnipForge/issues"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --features custom-protocol",
    "portable": "node scripts/make-portable.mjs",
    "icons": "node scripts/make-icons.mjs",
    "site:check": "node scripts/check-site.mjs",
    "site:ping": "node scripts/indexnow.mjs",
    "site:serve": "node -e \"const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';const fp=p.join('site',u);f.readFile(fp,(e,b)=>{if(e){r.writeHead(404);return r.end('404')}const t={'.html':'text/html; charset=utf-8','.png':'image/png','.txt':'text/plain; charset=utf-8','.xml':'application/xml'}[p.extname(fp)]||'application/octet-stream';r.writeHead(200,{'content-type':t});r.end(b)})}).listen(4173,()=>console.log('site → http://127.0.0.1:4173/'))\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
