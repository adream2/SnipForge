{
  "name": "snipforge",
  "version": "0.1.0",
  "description": "SnipForge — 集截图、录屏、剪贴板、图床、图片处理于一体的 Windows 桌面工具",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adream2/SnipForge.git"
  },
  "homepage": "https://github.com/adream2/SnipForge",
  "bugs": {
    "url": "https://github.com/adream2/SnipForge/issues"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --features custom-protocol",
    "portable": "node scripts/make-portable.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
